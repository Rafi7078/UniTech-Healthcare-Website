---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Uni Tech | Healthcare Solutions",
	description = "Uni Tech provides diagnostic equipment and healthcare solutions in Bangladesh.",
} = Astro.props;
---

<!doctype html>
<html lang="en">

	<head>

		<meta charset="UTF-8" />

		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0"
		/>

		<meta
			name="description"
			content={description}
		/>


		<!-- Favicon -->

		<link
			rel="icon"
			type="image/png"
			href="/images/unitech-icon2.png"
		/>


		<!-- Page Title -->

		<title>{title}</title>

	</head>



	<body class="bg-white text-gray-900">

		<Navbar />

		<slot />

	</body>

</html>