---
import {
	BadgeCheck,
	Globe2,
	Truck,
	Headset
} from "@lucide/astro";
---


<section id="quality" class="py-20 bg-white">

	<div class="max-w-7xl mx-auto px-6">


		<!-- Heading -->

		<div class="text-center max-w-3xl mx-auto mb-14">

			<p class="text-green-700 font-semibold mb-3">
				Our Quality
			</p>


			<h2 class="text-3xl md:text-4xl font-bold text-slate-900">
				Quality Healthcare Solutions You Can Trust
			</h2>


			<p class="mt-5 text-slate-600 leading-relaxed">
				Committed to delivering reliable healthcare products
				through strict quality control, trusted sourcing and
				professional support.
			</p>

		</div>





		<!-- Image + Cards -->

		<div class="grid lg:grid-cols-2 gap-10 items-center">



			<!-- Laboratory Image -->

			<div
				class="
				rounded-3xl
				overflow-hidden
				shadow-xl
				bg-gray-50"
			>

				<img
					src="/images/Pathology-lab.webp"
					alt="Quality Laboratory"
					class="
					w-full
					h-95
					object-cover"
				/>

			</div>








			<!-- Quality Cards -->

			<div class="grid sm:grid-cols-2 gap-6">



				<!-- Quality Products -->

				<div
					class="
					bg-gray-50
					border
					border-gray-100
					rounded-2xl
					p-6
					hover:shadow-lg
					hover:-translate-y-1
					transition
					duration-300"
				>

					<div
						class="
						w-12
						h-12
						rounded-xl
						bg-green-100
						flex
						items-center
						justify-center
						mb-5"
					>

						<BadgeCheck
							size={28}
							class="text-green-700"
						/>

					</div>


					<h3 class="text-lg font-semibold text-slate-900">
						Quality Products
					</h3>


					<p class="mt-3 text-sm text-slate-600 leading-relaxed">
						Carefully selected diagnostic equipment and
						healthcare solutions from trusted manufacturers.
					</p>


				</div>








				<!-- International Standards -->


				<div
					class="
					bg-gray-50
					border
					border-gray-100
					rounded-2xl
					p-6
					hover:shadow-lg
					hover:-translate-y-1
					transition
					duration-300"
				>


					<div
						class="
						w-12
						h-12
						rounded-xl
						bg-green-100
						flex
						items-center
						justify-center
						mb-5"
					>

						<Globe2
							size={28}
							class="text-green-700"
						/>

					</div>



					<h3 class="text-lg font-semibold text-slate-900">
						International Standards
					</h3>


					<p class="mt-3 text-sm text-slate-600 leading-relaxed">
						Following global quality practices to ensure
						reliable performance and safety.
					</p>


				</div>









				<!-- Supply Chain -->


				<div
					class="
					bg-gray-50
					border
					border-gray-100
					rounded-2xl
					p-6
					hover:shadow-lg
					hover:-translate-y-1
					transition
					duration-300"
				>


					<div
						class="
						w-12
						h-12
						rounded-xl
						bg-green-100
						flex
						items-center
						justify-center
						mb-5"
					>


						<Truck
							size={28}
							class="text-green-700"
						/>


					</div>



					<h3 class="text-lg font-semibold text-slate-900">
						Trusted Supply Chain
					</h3>


					<p class="mt-3 text-sm text-slate-600 leading-relaxed">
						Maintaining consistent product availability
						with dependable distribution.
					</p>


				</div>









				<!-- Customer Support -->


				<div
					class="
					bg-gray-50
					border
					border-gray-100
					rounded-2xl
					p-6
					hover:shadow-lg
					hover:-translate-y-1
					transition
					duration-300"
				>


					<div
						class="
						w-12
						h-12
						rounded-xl
						bg-green-100
						flex
						items-center
						justify-center
						mb-5"
					>


						<Headset
							size={28}
							class="text-green-700"
						/>


					</div>



					<h3 class="text-lg font-semibold text-slate-900">
						Customer Support
					</h3>


					<p class="mt-3 text-sm text-slate-600 leading-relaxed">
						Providing technical assistance and after-sales
						service for long-term partnerships.
					</p>


				</div>




			</div>


		</div>


	</div>


</section>