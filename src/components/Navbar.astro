---
---


<nav class="fixed top-0 left-0 w-full z-50 bg-white/90 backdrop-blur border-b border-gray-100">


	<div class="max-w-7xl mx-auto px-6">


		<div class="flex items-center justify-between h-20">


			<!-- Logo -->

			<a 
				href="/"
				class="flex items-center"
			>

				<img
					src="/images/unitech-logo-new.png"
					alt="Uni Tech"
					class="
					h-12
					sm:h-14
					w-auto
					object-contain"
				/>

			</a>


			<!-- Desktop Menu -->

			<div class="hidden md:flex items-center gap-8">


				<a href="/#home"
				class="text-slate-600 hover:text-green-700 transition">
					Home
				</a>


				<a href="/#about"
				class="text-slate-600 hover:text-green-700 transition">
					About Us
				</a>


				<a href="/#products"
				class="text-slate-600 hover:text-green-700 transition">
					Products
				</a>


				<a href="/#services"
				class="text-slate-600 hover:text-green-700 transition">
					Services
				</a>


				<a href="/#partners"
				class="text-slate-600 hover:text-green-700 transition">
					Partners
				</a>


				<a href="/#quality"
				class="text-slate-600 hover:text-green-700 transition">
					Quality
				</a>


				<a href="/#contact"
				class="text-slate-600 hover:text-green-700 transition">
					Contact
				</a>


			</div>



			<!-- CTA -->

			<a
				href="/#contact"
				class="
				hidden
				md:block
				bg-green-700
				text-white
				px-6
				py-3
				rounded-xl
				font-medium
				hover:bg-green-800
				transition"
			>
				Request Quote
			</a>



			<!-- Mobile Button -->

			<button
				id="menuBtn"
				class="
				md:hidden
				text-2xl
				text-slate-700"
			>
				☰
			</button>


		</div>


		<div
			id="mobileMenu"
			class="
			hidden
			md:hidden
			pb-6
			pt-3
			space-y-4"
		>


			<a href="/#home" class="block text-slate-700">
				Home
			</a>

			<a href="/#about" class="block text-slate-700">
				About Us
			</a>

			<a href="/#products" class="block text-slate-700">
				Products
			</a>

			<a href="/#services" class="block text-slate-700">
				Services
			</a>

			<a href="/#partners" class="block text-slate-700">
				Partners
			</a>

			<a href="/#quality" class="block text-slate-700">
				Quality
			</a>

			<a href="/#contact" class="block text-slate-700">
				Contact
			</a>


		</div>


	</div>


</nav>



<script is:inline>

const btn = document.getElementById("menuBtn");

const menu = document.getElementById("mobileMenu");


btn?.addEventListener("click",()=>{

	menu?.classList.toggle("hidden");

});


document
.querySelectorAll("#mobileMenu a")
.forEach((link)=>{

	link.addEventListener("click",()=>{

		menu?.classList.add("hidden");

	});

});


</script>