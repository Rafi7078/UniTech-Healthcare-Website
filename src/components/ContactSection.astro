<section id="contact" class="bg-green-700 py-20 relative overflow-hidden">

	<div class="max-w-7xl mx-auto px-6">

		<div class="grid md:grid-cols-2 gap-12 items-start">


			<!-- Left Content -->

			<div class="text-white">

				<p class="font-semibold mb-3 text-green-100">
					Contact Us
				</p>


				<h2 class="text-3xl md:text-4xl font-bold">
					Let's Work Together
				</h2>


				<p class="mt-5 text-green-50 leading-relaxed">
					Need diagnostic equipment, laboratory solutions
					or healthcare product support?
					Get in touch with our team today.
				</p>



				<div class="mt-8 space-y-4">


					<div>
						<p class="text-green-100 text-sm">
							Email
						</p>

						<p class="font-medium">
							info@uni-techbd.com
						</p>
					</div>


					<div>
						<p class="text-green-100 text-sm">
							Phone
						</p>

						<p class="font-medium">
							01552-340630
						</p>
					</div>


					<div>
						<p class="text-green-100 text-sm">
							Location
						</p>

						<p class="font-medium">
							12/D, Lane-6, Plot-I/32,
	                         Pallabi, Mirpur,
	                         Dhaka-1216
						</p>
					</div>


				</div>


			</div>





			<!-- Form -->

			<div class="bg-white rounded-3xl p-8 shadow-2xl relative z-10">


				<form
					id="contact-form"
					action="https://formspree.io/f/moejdqbo"
					method="POST"
					class="space-y-5"
				>


					<input
						type="hidden"
						name="_subject"
						value="New Healthcare Inquiry - Uni Tech"
					/>


					<input
						type="text"
						name="_gotcha"
						class="hidden"
					/>



					<input
						type="text"
						name="name"
						placeholder="Your Name"
						required
						class="w-full rounded-lg border border-gray-200
						px-4 py-3 focus:outline-none focus:border-green-600"
					/>



					<input
						type="text"
						name="company"
						placeholder="Company Name"
						class="w-full rounded-lg border border-gray-200
						px-4 py-3 focus:outline-none focus:border-green-600"
					/>




					<input
						type="email"
						name="email"
						placeholder="Email Address"
						required
						class="w-full rounded-lg border border-gray-200
						px-4 py-3 focus:outline-none focus:border-green-600"
					/>




					<input
						type="tel"
						name="phone"
						placeholder="Phone Number"
						class="w-full rounded-lg border border-gray-200
						px-4 py-3 focus:outline-none focus:border-green-600"
					/>




					<textarea
						name="message"
						rows="4"
						placeholder="Your Message"
						class="w-full rounded-lg border border-gray-200
						px-4 py-3 focus:outline-none focus:border-green-600"
					></textarea>




					<button
						type="submit"
						class="w-full bg-green-700 text-white
						py-3 rounded-lg font-medium
						hover:bg-green-800 transition"
					>
						Request Quote
					</button>


					<div
						id="form-message"
						class="hidden text-center font-medium mt-4"
					>
					</div>


				</form>


			</div>


		</div>


	</div>

<!-- Smooth Green to Footer Transition -->
	<div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none">

		<svg
			class="relative block w-full h-16"
			viewBox="0 0 1200 120"
			preserveAspectRatio="none"
		>

			<path
				d="M0,0 C300,100 900,100 1200,0 L1200,120 L0,120 Z"
				fill="#020617"
			></path>

		</svg>

	</div>
    

</section>



<script>
	const form = document.querySelector<HTMLFormElement>("#contact-form");
	const message = document.querySelector<HTMLDivElement>("#form-message");


	form?.addEventListener("submit", async (e) => {

		e.preventDefault();


		const button = form.querySelector<HTMLButtonElement>("button");


		if (!button || !message) return;


		button.disabled = true;
		button.innerText = "Sending...";


		const formData = new FormData(form);


		try {

			const response = await fetch(form.action, {

				method: "POST",

				body: formData,

				headers: {
					Accept: "application/json"
				}

			});


			if (response.ok) {


				message.className =
					"mt-4 text-center font-medium text-green-700";


				message.innerText =
					"Thank you for contacting Uni Tech. Our team will contact you shortly.";


				message.classList.remove("hidden");


				form.reset();


			} else {

				throw new Error("Form submission failed");

			}



		} catch (error) {


			message.className =
				"mt-4 text-center font-medium text-red-600";


			message.innerText =
				"Something went wrong. Please try again.";


			message.classList.remove("hidden");


		}



		button.disabled = false;
		button.innerText = "Request Quote";


	});
</script>