---
import {
	Globe2,
	FlaskConical,
	Settings,
	Truck
} from "@lucide/astro";
---


<section class="bg-gray-50 py-20">

	<div class="max-w-7xl mx-auto px-6">


		<!-- Section Heading -->

		<div class="text-center max-w-2xl mx-auto mb-12">


			<p class="text-green-700 font-semibold mb-3">
				Why Choose Uni Tech
			</p>


			<h2 class="text-3xl md:text-4xl font-bold text-gray-900">
				Trusted Healthcare Partner
			</h2>


			<p class="mt-4 text-gray-600 leading-relaxed">
				Delivering reliable diagnostic solutions through
				quality products, trusted partnerships and professional support.
			</p>


		</div>





		<!-- Cards -->

		<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">



			<!-- Global Brands -->

			<div
				class="
				bg-white
				p-6
				rounded-2xl
				border
				border-gray-100
				hover:shadow-xl
				hover:-translate-y-1
				transition
				duration-300"
			>

				<div
					class="
					w-12
					h-12
					rounded-xl
					bg-green-100
					flex
					items-center
					justify-center
					mb-5"
				>

					<Globe2 
						size={26}
						class="text-green-700"
					/>

				</div>


				<h3 class="font-semibold text-lg text-gray-900">
					Global Brands
				</h3>


				<p class="mt-2 text-gray-600 text-sm leading-relaxed">
					Partnering with internationally recognized healthcare manufacturers.
				</p>


			</div>







			<!-- Diagnostic Solutions -->

			<div
				class="
				bg-white
				p-6
				rounded-2xl
				border
				border-gray-100
				hover:shadow-xl
				hover:-translate-y-1
				transition
				duration-300"
			>


				<div
					class="
					w-12
					h-12
					rounded-xl
					bg-green-100
					flex
					items-center
					justify-center
					mb-5"
				>

					<FlaskConical
						size={26}
						class="text-green-700"
					/>

				</div>



				<h3 class="font-semibold text-lg text-gray-900">
					Diagnostic Solutions
				</h3>


				<p class="mt-2 text-gray-600 text-sm leading-relaxed">
					Providing advanced laboratory equipment and diagnostic solutions.
				</p>


			</div>








			<!-- Technical Support -->

			<div
				class="
				bg-white
				p-6
				rounded-2xl
				border
				border-gray-100
				hover:shadow-xl
				hover:-translate-y-1
				transition
				duration-300"
			>


				<div
					class="
					w-12
					h-12
					rounded-xl
					bg-green-100
					flex
					items-center
					justify-center
					mb-5"
				>

					<Settings
						size={26}
						class="text-green-700"
					/>

				</div>



				<h3 class="font-semibold text-lg text-gray-900">
					Technical Support
				</h3>


				<p class="mt-2 text-gray-600 text-sm leading-relaxed">
					Supporting installation, guidance and product assistance.
				</p>


			</div>








			<!-- Reliable Supply -->

			<div
				class="
				bg-white
				p-6
				rounded-2xl
				border
				border-gray-100
				hover:shadow-xl
				hover:-translate-y-1
				transition
				duration-300"
			>


				<div
					class="
					w-12
					h-12
					rounded-xl
					bg-green-100
					flex
					items-center
					justify-center
					mb-5"
				>

					<Truck
						size={26}
						class="text-green-700"
					/>

				</div>



				<h3 class="font-semibold text-lg text-gray-900">
					Reliable Supply
				</h3>


				<p class="mt-2 text-gray-600 text-sm leading-relaxed">
					Ensuring dependable healthcare product availability.
				</p>


			</div>



		</div>


	</div>


</section>