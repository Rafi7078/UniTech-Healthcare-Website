---
import { SITE } from "../config/site";
---

<section id="home" class="relative overflow-hidden bg-white">

	<div class="max-w-7xl mx-auto px-6 py-24 grid md:grid-cols-2 gap-12 items-center">


		<!-- Left Content -->

		<div>


			<p class="text-green-700 font-semibold mb-4">
				Healthcare Solutions Partner
			</p>



			<h1 class="text-5xl md:text-6xl font-bold leading-tight text-gray-900">

				Advanced Diagnostic

				<br />

				<span class="text-green-700">
					Solutions for Modern
				</span>

				<br />

				Healthcare

			</h1>



			<p class="mt-6 text-lg text-gray-600 max-w-xl leading-relaxed">
				{SITE.description}
			</p>




			<div class="mt-8 flex gap-4 flex-wrap">


				<a
					href="#products"
					class="
					bg-green-700 
					text-white 
					px-6 
					py-3 
					rounded-lg
					hover:bg-green-800 
					transition
					font-medium"
				>
					Explore Products
				</a>




				<a
					href="#contact"
					class="
					border 
					border-green-700 
					text-green-700
					px-6 
					py-3 
					rounded-lg
					hover:bg-green-50 
					transition
					font-medium"
				>
					Request Quote
				</a>


			</div>


		</div>






		<!-- Right Image -->

		<div class="relative flex justify-center">


			<!-- Background Glow -->

			<div
				class="
				absolute
				w-105
				h-105
				bg-linear-to-br
				from-green-100
				to-green-50
				rounded-full
				blur-3xl
				opacity-70">
			</div>





			<!-- Image Card -->

			<div
				class="
				relative
				bg-white
				rounded-4xl
				p-6
				border
				border-gray-100
				shadow-xl"
			>



				<img
					src="/images/Erba-XL180Analyzer.webp"
					alt="Erba XL180 Diagnostic Analyzer"
					class="
					w-full
					max-w-xl
					object-contain
					rounded-2xl"
				/>






				<!-- Floating Badge -->


				<div
					class="
					absolute
					-bottom-6
					-left-6
					bg-white
					shadow-xl
					rounded-2xl
					px-6
					py-4
					border
					border-gray-100"
				>


					<p class="text-green-700 font-bold">
						✓ Trusted Partner
					</p>


					<p class="text-sm text-gray-500 mt-1">
						Advanced Diagnostic Equipment
					</p>


				</div>



			</div>



		</div>



	</div>

</section>