---
import {
	Mail,
	Phone,
	MapPin
} from "@lucide/astro";
---


<footer class="bg-gray-950 text-gray-300">


	<div class="max-w-7xl mx-auto px-6 py-16">


		<div class="grid md:grid-cols-4 gap-10">






			<!-- Company -->


			<div>


				<a href="/" class="inline-block mb-5">


					<img
						src="/images/unitech-logo.webp"
						alt="Uni Tech"
						class="
						h-14
						w-auto
						object-contain
						bg-white
						rounded-lg
						p-2"
					/>


				</a>



				<p class="text-gray-400 leading-relaxed">

					Uni Tech is a trusted healthcare solution provider
					specialized in diagnostic equipment, laboratory
					reagents and medical solutions in Bangladesh.

				</p>


			</div>









			<!-- Quick Links -->


			<div>


				<h4 class="text-white font-semibold mb-5">
					Quick Links
				</h4>



				<ul class="space-y-3">


					<li>

						<a 
							href="#home"
							class="hover:text-green-500 transition"
						>
							Home
						</a>

					</li>



					<li>

						<a 
							href="#about"
							class="hover:text-green-500 transition"
						>
							About Us
						</a>

					</li>




					<li>

						<a 
							href="#products"
							class="hover:text-green-500 transition"
						>
							Products
						</a>

					</li>




					<li>

						<a 
							href="#contact"
							class="hover:text-green-500 transition"
						>
							Contact
						</a>

					</li>


				</ul>


			</div>









			<!-- Products -->


			<div>


				<h4 class="text-white font-semibold mb-5">
					Products
				</h4>



				<ul class="space-y-3 text-gray-400">


					<li>
						Hematology Analyzer
					</li>


					<li>
						Electrolyte Analyzer
					</li>


					<li>
						Clinical Chemistry Analyzer
					</li>


					<li>
						Diagnostic Reagents
					</li>


				</ul>


			</div>









			<!-- Contact -->


			<div>


				<h4 class="text-white font-semibold mb-5">
					Contact
				</h4>




				<ul class="space-y-5">





					<li class="flex gap-3">


						<Mail
							size={18}
							class="text-green-500 mt-1 shrink-0"
						/>


						<span>
							info@unitech.com
						</span>


					</li>








					<li class="flex gap-3">


						<Phone
							size={18}
							class="text-green-500 mt-1 shrink-0"
						/>


						<span>
							+880 1552-340630
						</span>


					</li>








					<li class="flex gap-3">


						<MapPin
							size={18}
							class="text-green-500 mt-1 shrink-0"
						/>


						<span class="leading-relaxed">

							12/D, Lane-6, Plot-I/32,
							Pallabi, Mirpur,
							Dhaka-1216

						</span>


					</li>



				</ul>


			</div>





		</div>


	</div>









	<!-- Bottom Copyright -->


	<div class="border-t border-gray-800">


		<div
			class="
			max-w-7xl
			mx-auto
			px-6
			py-5
			text-center
			text-sm
			text-gray-500"
		>


			© 2026 Uni Tech. All Rights Reserved.


		</div>


	</div>





</footer>