---
import {
	Settings,
	Wrench,
	Building2,
	ShieldCheck
} from "@lucide/astro";
---


<section id="services" class="bg-gray-50 py-20">

	<div class="max-w-7xl mx-auto px-6">


		<!-- Heading -->

		<div class="text-center max-w-2xl mx-auto mb-12">

			<p class="text-green-700 font-semibold mb-3">
				Our Services
			</p>


			<h2 class="text-3xl md:text-4xl font-bold text-gray-900">
				Complete Healthcare Support Solutions
			</h2>


			<p class="mt-4 text-gray-600">
				From equipment installation to technical support,
				we provide reliable solutions for modern diagnostic
				laboratories.
			</p>

		</div>




		<!-- Service Image -->

		<div class="mb-14">

			<div
				class="
				relative
				rounded-3xl
				overflow-hidden
				shadow-xl
				bg-white"
			>

				<img
					src="/images/service-lab.webp"
					alt="Healthcare Laboratory Service"
					class="
					w-full
					h-90
					md:h-105
					object-cover
					object-[center_28%]"
				/>


				<!-- Badge -->

				<div
					class="
					absolute
					bottom-5
					left-5
					bg-white/90
					backdrop-blur-sm
					shadow-lg
					rounded-xl
					px-6
					py-4
					border
					border-gray-100"
				>

					<p class="text-green-700 font-bold">
						✓ Professional Healthcare Support
					</p>


					<p class="text-sm text-gray-500">
						Installation • Maintenance • Technical Assistance
					</p>

				</div>

			</div>

		</div>





		<!-- Service Cards -->

		<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">



			<!-- Card 1 -->

			<div
				class="
				group
				bg-white
				rounded-2xl
				border
				border-gray-100
				p-6
				hover:shadow-xl
				hover:-translate-y-2
				transition
				duration-300"
			>

				<div
					class="
					w-14
					h-14
					bg-green-50
					rounded-2xl
					flex
					items-center
					justify-center
					mb-5
					group-hover:bg-green-100
					transition"
				>

					<Settings
						size={28}
						class="text-green-700"
					/>

				</div>


				<h3 class="text-lg font-semibold text-gray-900">
					Equipment Installation
				</h3>


				<p class="mt-3 text-sm text-gray-600">
					Professional installation and setup of
					advanced diagnostic equipment for laboratories.
				</p>


			</div>






			<!-- Card 2 -->

			<div
				class="
				group
				bg-white
				rounded-2xl
				border
				border-gray-100
				p-6
				hover:shadow-xl
				hover:-translate-y-2
				transition
				duration-300"
			>

				<div
					class="
					w-14
					h-14
					bg-green-50
					rounded-2xl
					flex
					items-center
					justify-center
					mb-5
					group-hover:bg-green-100
					transition"
				>

					<Wrench
						size={28}
						class="text-green-700"
					/>

				</div>


				<h3 class="text-lg font-semibold text-gray-900">
					Technical Support
				</h3>


				<p class="mt-3 text-sm text-gray-600">
					Dedicated technical assistance to ensure
					smooth laboratory operations.
				</p>


			</div>







			<!-- Card 3 -->

			<div
				class="
				group
				bg-white
				rounded-2xl
				border
				border-gray-100
				p-6
				hover:shadow-xl
				hover:-translate-y-2
				transition
				duration-300"
			>

				<div
					class="
					w-14
					h-14
					bg-green-50
					rounded-2xl
					flex
					items-center
					justify-center
					mb-5
					group-hover:bg-green-100
					transition"
				>

					<Building2
						size={28}
						class="text-green-700"
					/>

				</div>


				<h3 class="text-lg font-semibold text-gray-900">
					Laboratory Setup
				</h3>


				<p class="mt-3 text-sm text-gray-600">
					Complete laboratory planning and solutions
					for healthcare institutions.
				</p>


			</div>







			<!-- Card 4 -->

			<div
				class="
				group
				bg-white
				rounded-2xl
				border
				border-gray-100
				p-6
				hover:shadow-xl
				hover:-translate-y-2
				transition
				duration-300"
			>

				<div
					class="
					w-14
					h-14
					bg-green-50
					rounded-2xl
					flex
					items-center
					justify-center
					mb-5
					group-hover:bg-green-100
					transition"
				>

					<ShieldCheck
						size={28}
						class="text-green-700"
					/>

				</div>


				<h3 class="text-lg font-semibold text-gray-900">
					After Sales Service
				</h3>


				<p class="mt-3 text-sm text-gray-600">
					Reliable maintenance support and customer
					service after product delivery.
				</p>


			</div>



		</div>


	</div>

</section>